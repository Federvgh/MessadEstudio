  "algoritmo_deteccion": {
    "pasos": [
      "1. Obtener dirección y coordenadas del lote",
      "2. Consultar GeoServer IDECOR para datos catastrales",
      "3. Buscar calle en mapeo_calles_zonas",
      "4. Si no se encuentra, usar zona default según ubicación geográfica",
      "5. Consultar datos de la zona (FOS, FOT, altura, perfil)",
      "6. Aplicar cálculos según superficie del lote",
      "7. Generar recomendaciones según normativa"
    ],
    "zona_default": "B",
    "notas": "En Córdoba, la zonificación es más compleja que en Santiago. Consultar siempre normativa actualizada."
  },

  "calculos": {
    "superficie_construible_pb": "superficie_lote * fos",
    "superficie_construible_total": "superficie_lote * fot",
    "plantas_estimadas": "Math.floor(fot / fos)",
    "retiro_fondo_categoria_1": "Math.max(altura_maxima * 0.25, 3.0)",
    "retiro_fondo_categoria_2": 3.0
  },

  "notas_importantes": [
    "La Ordenanza 8256 es compleja y tiene múltiples modificatorias",
    "Zonas C1, C2, C3 tienen reglas especiales según ubicación",
    "Algunas zonas requieren consulta obligatoria con Planeamiento Urbano",
    "FOS puede ser 1.0 en zonas centrales (100% de ocupación)",
    "Verificar siempre actualizaciones en: https://gobiernoabierto.cordoba.gob.ar"
  ],

